      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "graphMode": "none",
        "colorMode": "value"
      },
      "id": 3,
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Compressor power",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb"
          },
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r.machine_id == \"${machine}\")\n  |> filter(fn: (r) => r._field == \"compressor_power_w\")\n  |> group(columns: [\"_field\"])\n  |> sort(columns: [\"_time\"])\n  |> last()\n  |> keep(columns: [\"_time\", \"_field\", \"_value\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "graphMode": "none",
        "colorMode": "value"
      },
      "id": 4,
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      }
    },
    {
      "id": 8,
      "type": "state-timeline",
      "title": "Active fault (ground truth label)",
      "description": "Label injected by the simulator. A real machine would not know it: it is here to check the ML anomaly score in phase 3.",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb"
          },
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r.machine_id == \"${machine}\")\n  |> filter(fn: (r) => r._field == \"cell_temp_c\")\n  |> group()\n  |> sort(columns: [\"_time\"])\n  |> aggregateWindow(every: v.windowPeriod, fn: last, createEmpty: false)\n  |> map(fn: (r) => ({_time: r._time, fault: r.label}))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "red"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "normal": {
                  "text": "normal",
                  "color": "green",
                  "index": 0
                },
                "refrigerant_leak": {
                  "text": "refrigerant_leak",
                  "color": "red",
                  "index": 1
                },
                "compressor_wear": {
                  "text": "compressor_wear",
                  "color": "orange",
                  "index": 2
                },
                "door_gasket": {
                  "text": "door_gasket",
                  "color": "purple",
                  "index": 3
                },
                "sensor_drift": {
                  "text": "sensor_drift",
                  "color": "yellow",
                  "index": 4
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "showValue": "auto",
        "mergeValues": true,
        "legend": {
          "showLegend": false
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Temperatures",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb"
          },
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r.machine_id == \"${machine}\")\n  |> filter(fn: (r) => r._field == \"cell_temp_c\" or r._field == \"product_temp_c\" or r._field == \"active_setpoint_c\")\n  |> group(columns: [\"_field\"])\n  |> sort(columns: [\"_time\"])\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> keep(columns: [\"_time\", \"_field\", \"_value\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "active_setpoint_c"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              }
            ]
          }
        ]
      },
      "id": 5,
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 16,
        "h": 10
      }
    },
    {
      "type": "timeseries",
      "title": "Compressor power",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb"
          },
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r.machine_id == \"${machine}\")\n  |> filter(fn: (r) => r._field == \"compressor_power_w\")\n  |> group(columns: [\"_field\"])\n  |> sort(columns: [\"_time\"])\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> keep(columns: [\"_time\", \"_field\", \"_value\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "custom": {
            "fillOpacity": 20
          }
        },
        "overrides": []
      },
      "id": 6,
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb"
      },
      "gridPos": {
        "x": 16,
        "y": 9,
        "w": 8,
        "h": 10
      }
    },
    {
      "type": "state-timeline",
      "title": "Compressor and door",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb"
          },
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r.machine_id == \"${machine}\")\n  |> filter(fn: (r) => r._field == \"compressor_on\" or r._field == \"door_open\")\n  |> group(columns: [\"_field\"])\n  |> sort(columns: [\"_time\"])\n  |> toInt()\n  |> keep(columns: [\"_time\", \"_field\", \"_value\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "off / closed",
                  "color": "transparent"
                },
                "1": {
                  "text": "on / open",
                  "color": "blue"
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "mergeValues": true
      },
      "id": 7,
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb"
      },
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 24,
        "h": 5
      }
    }
  ]
